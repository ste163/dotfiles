#!/bin/sh
# tmux-auto-saver: entry point for Ghostty. Attach to the live server if
# one exists; otherwise restore the last saved state (if any) and attach;
# otherwise start a fresh session.
#
# POSIX sh only: runs on macOS and Linux.

# Ghostty launches commands via a bare login shell (--noprofile --norc),
# so Homebrew binaries are missing from PATH. Normalize PATH first so tmux
# and friends resolve on every launch path.
PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
export PATH

if tmux has-session 2>/dev/null; then
    exec tmux attach
fi

"$HOME/.local/bin/tmux-state-restore"

if tmux has-session 2>/dev/null; then
    exec tmux attach
fi

exec tmux new-session
