#!/bin/sh
# tmux-state-save: snapshot every tmux session into a replay script at
# tmux/state/state.txt (next to this script's real location). tmux hooks
# run this on layout changes and detach; tmux-state-restore replays the
# file after a reboot.
#
# What the replay restores:
#   - sessions, windows (names and original indexes), panes
#   - exact geometry via select-layout (layout string round-trip)
#   - per-pane working directory
#   - allowlisted foreground commands re-run with full argv
#   - active pane focus and window zoom state
#
# POSIX sh only: runs on macOS and Linux.

# Ghostty launches commands via a bare login shell (--noprofile --norc),
# so Homebrew binaries are missing from PATH. Normalize PATH first so tmux
# and friends resolve on every launch path.
PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
export PATH

ALLOWLIST_NVIM="nvim"
ALLOWLIST_BTOP="btop"
ALLOWLIST_UV_NVIM="uv run nvim"
DEBOUNCE=2
MARKER_TTL=60

set -f
IFS='
'

SCRIPT_DIR=
STATE_DIR=
STATE=
EPOCH=
TMP=

# Resolve this script's real path through the symlink chain. macOS has no
# readlink -f, so walk manually; relative links resolve against dirname.
resolve_self() {
    SELF=$0
    case "$SELF" in
        */*) ;;
        *) SELF="./$SELF" ;;
    esac
    while [ -L "$SELF" ]; do
        LINK=$(readlink "$SELF")
        case "$LINK" in
            /*) SELF=$LINK ;;
            *) SELF=$(dirname "$SELF")/$LINK ;;
        esac
    done
    SCRIPT_DIR=$(cd "$(dirname "$SELF")" && pwd)
}

# Shell-quote one value for replay into the generated script.
quote() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# Prefix match on the full argv: "nvim", "btop", "uv run nvim" (with or
# without trailing arguments). Anything else stays a fresh shell on restore.
is_allowlisted() {
    case "$1" in
        "$ALLOWLIST_NVIM" | "$ALLOWLIST_NVIM "*) return 0 ;;
        "$ALLOWLIST_BTOP" | "$ALLOWLIST_BTOP "*) return 0 ;;
        "$ALLOWLIST_UV_NVIM" | "$ALLOWLIST_UV_NVIM "*) return 0 ;;
        *) return 1 ;;
    esac
}

# $1 = pane shell pid. Exactly one child = foreground command: print its
# full argv. Zero or several children = no answer (nothing to restore).
resolve_argv() {
    CHILDREN=$(pgrep -P "$1" 2>/dev/null) || return 1
    COUNT=0
    for C in $CHILDREN; do
        COUNT=$((COUNT + 1))
        [ "$COUNT" -gt 1 ] && return 1
        CHILD=$C
    done
    [ "$COUNT" -eq 1 ] || return 1
    ps -p "$CHILD" -o command= 2>/dev/null \
        | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

emit() {
    printf '%s\n' "$*" >> "$TMP"
}

main() {
    resolve_self
    STATE_DIR="$SCRIPT_DIR/state"
    STATE="$STATE_DIR/state.txt"
    EPOCH="$STATE_DIR/state.epoch"

    tmux has-session 2>/dev/null || exit 0
    NOW=$(date +%s)

    # Restore in progress: never snapshot a half-built session. The marker
    # holds the epoch when restore started; honor it only while fresh. If
    # restore died mid-replay the marker goes stale, and ignoring it here
    # lets saving self-heal instead of being suppressed forever.
    if [ -f "$STATE_DIR/restoring" ]; then
        read -r MARKED < "$STATE_DIR/restoring" 2>/dev/null || MARKED=0
        case "$MARKED" in
            *[!0-9]*|'') MARKED=0 ;;
        esac
        [ $((NOW - MARKED)) -lt "$MARKER_TTL" ] && exit 0
    fi
    mkdir -p "$STATE_DIR"

    # Debounce: hooks fire in floods (window resizing), one save per window.
    if [ -f "$EPOCH" ]; then
        read -r LAST < "$EPOCH" 2>/dev/null || LAST=0
        [ $((NOW - LAST)) -lt "$DEBOUNCE" ] && exit 0
    fi
    printf '%s\n' "$NOW" > "$EPOCH"

    # Atomic write: temp file then rename, so a concurrent reader never
    # sees a half-written state.
    TMP="$STATE.tmp.$$"
    : > "$TMP"
    emit "# tmux-state replay script (generated by tmux-state-save)"

    for S in $(tmux list-sessions -F '#{session_name}'); do
        emit "tmux new-session -d -s $(quote "$S")"

        HAS_ZERO=0
        for IDX in $(tmux list-windows -t "$S" -F '#{window_index}'); do
            WNAME=$(tmux display-message -p -t "$S:$IDX" '#{window_name}')
            LAYOUT=$(tmux display-message -p -t "$S:$IDX" '#{window_layout}')
            ZOOMED=$(tmux display-message -p -t "$S:$IDX" '#{window_zoomed_flag}')

            if [ "$IDX" = "0" ]; then
                HAS_ZERO=1
                emit "tmux rename-window -t $(quote "$S:0") $(quote "$WNAME")"
            else
                # Create at the next free index, then move to the saved
                # index. move-window shifts any occupants, so gaps in the
                # saved indexes survive the round-trip.
                emit "NEW_IDX=\$(tmux new-window -d -P -F '#{window_index}' -t $(quote "$S:") -n $(quote "$WNAME")) && [ \"\$NEW_IDX\" != $(quote "$IDX") ] && tmux move-window -s \"$S:\$NEW_IDX\" -t $(quote "$S:$IDX")"
            fi

            ACTIVE_IDX=0
            for PIDX in $(tmux list-panes -t "$S:$IDX" -F '#{pane_index}'); do
                CWD=$(tmux display-message -p -t "$S:$IDX.$PIDX" '#{pane_current_path}')
                ACTIVE=$(tmux display-message -p -t "$S:$IDX.$PIDX" '#{pane_active}')
                PPID_=$(tmux display-message -p -t "$S:$IDX.$PIDX" '#{pane_pid}')

                if [ "$PIDX" = "0" ]; then
                    emit "tmux respawn-pane -k -c $(quote "$CWD") -t $(quote "$S:$IDX.0")"
                else
                    emit "tmux split-window -d -c $(quote "$CWD") -t $(quote "$S:$IDX")"
                fi

                ARGV=$(resolve_argv "$PPID_")
                if [ -n "$ARGV" ] && is_allowlisted "$ARGV"; then
                    # Respawn through an interactive zsh so the app gets the
                    # user's shell environment (.zshrc exports); exec a fresh
                    # interactive zsh when the app exits so the pane survives.
                    emit "tmux respawn-pane -k -c $(quote "$CWD") -t $(quote "$S:$IDX.$PIDX") $(quote "zsh -ic \"$ARGV; exec zsh -i\"")"
                fi

                if [ "$ACTIVE" = "1" ]; then
                    ACTIVE_IDX=$PIDX
                    emit "tmux select-pane -t $(quote "$S:$IDX.$PIDX")"
                fi
            done

            emit "tmux select-layout -t $(quote "$S:$IDX") $(quote "$LAYOUT")"
            if [ "$ZOOMED" = "1" ]; then
                emit "tmux resize-pane -t $(quote "$S:$IDX.$ACTIVE_IDX") -Z"
            fi
        done

        # new-session always creates a window 0; drop it if not saved.
        if [ "$HAS_ZERO" -eq 0 ]; then
            emit "tmux kill-window -t $(quote "$S:0")"
        fi
    done

    mv "$TMP" "$STATE"
}

main "$@"
