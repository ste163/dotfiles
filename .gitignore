# Runtime tmux state: machine-specific session dumps, regenerated on every
# hook save. Never commit.
tmux/state/

# Never commit secrets or machine-specific pi state.
# These should never exist under .pi/ in this repo, but this is belt-and-suspenders
# protection since .pi/agent is a public dotfiles-managed directory.
.pi/auth.json
.pi/models.json
.pi/trust.json
.pi/sessions/
.pi/npm/
.pi/git/
**logs

# Generated by `codebase-memory-mcp update` — machine-specific (cbmem.ts embeds
# an absolute binary path) and regenerated on every install/update.
.pi/extensions/cbmem.ts
.pi/skills/codebase-memory/

.pi-lens/*
!.pi-lens/config.json

*.DS_Store
