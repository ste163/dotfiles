shell-integration = "zsh"

# Every Ghostty surface attaches to the tmux session, restoring the last
# saved state after a reboot. shell: prefix forces /bin/sh -c so ~ expands
# (a bare command path is exec'd directly, no expansion).
command = shell:~/.local/bin/tmux-auto-saver

font-family = "BitstromWera Nerd Font Mono"
font-size = 16

background-blur-radius = 20
background-opacity = 0.9

theme = Rose Pine Moon

window-padding-y = 0,10
window-padding-x = 10,10

# Cleanup window header, but keeps top bar for window movement
title = " " 
window-subtitle = false
shell-integration-features = no-title
macos-titlebar-style = "transparent"
macos-titlebar-proxy-icon = "hidden"
